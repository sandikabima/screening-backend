{
  "name": "Screening Kesehatan Mental",
  "version": "1.0.0",
  "description": "Backend Mental Health Screening Managemenet Backend for Shaumy",
  "main": "dist/index.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test tsx --test ./tests",
    "dev": "cross-env PORT=8080 nodemon --exec ts-node src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "cross-env NODE_ENV=production PORT=8080 node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:studio": "drizzle-kit studio --port 4983 --host 127.0.0.1",
    "db:seed": "cross-env NODE_ENV=development ts-node src/seeds/questionSeeder.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "api",
    "backend",
    "drizzle",
    "jwt"
  ],
  "author": "Bima Sandika",
  "license": "ISC",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/morgan": "^1.9.10",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "winston": "^3.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.32.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "supertest": "^7.2.2",
    "typescript": "^5.8.3"
  }
}
